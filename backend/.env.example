# Server Port
PORT=5000
NODE_ENV=production

# --- OPTION A: Railway MySQL (Public or Internal URL) ---
# Paste your Railway MySQL connection URL here:
# MYSQL_URL=mysql://root:password@monorail.proxy.rlwy.net:12345/railway

# --- OPTION B: Railway / Cloud Individual Variables ---
# MYSQLHOST=monorail.proxy.rlwy.net
# MYSQLPORT=12345
# MYSQLUSER=root
# MYSQLPASSWORD=your_railway_password
# MYSQLDATABASE=railway

# --- OPTION C: Local MySQL Server ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=threadline_db

# Security & JWT
JWT_SECRET=threadline_super_secure_jwt_secret_token_key_2026
JWT_EXPIRES_IN=7d

